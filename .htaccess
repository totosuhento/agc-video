# AGC Video — untuk shared hosting bila document root = folder ini (bukan public/).
# Lebih baik arahkan document root domain ke folder public/; file ini hanya cadangan.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Folder & file internal tidak boleh diakses dari web
  RewriteRule ^(app|cli|storage|docker|\.git|\.github)(/|$) - [F,L]
  RewriteRule ^(Dockerfile|docker-compose\.yml|Caddyfile|.*\.md|\.dockerignore|\.gitignore)$ - [F,L]

  # File statis yang ada di public/ (mis. /assets/style.css)
  RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
  RewriteRule ^(.+)$ public/$1 [L]

  # Selain itu → aplikasi
  RewriteCond %{REQUEST_URI} !^/public/
  RewriteRule ^ index.php [L,QSA]
</IfModule>
